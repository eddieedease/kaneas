{
  "name": "kaneas",
  "version": "0.2.0",
  "private": true,
  "description": "Collaborative kanban boards — Angular frontend, PHP/MySQL backend for shared hosting.",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "start": "npm --prefix frontend start",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "build": "node scripts/build.mjs",
    "build:zip": "node scripts/build.mjs --zip",
    "test": "npm --prefix frontend test -- --watch=false"
  }
}
