# Kaneas — Angular routing + caching. RewriteBase is set by the installer.
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Build output is content hashed, so it can be cached forever.
    <FilesMatch "-[A-Za-z0-9]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # The API and installer have their own rules
    RewriteRule ^(api|install)(/|$) - [L]

    # Serve existing files and folders as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is an Angular route
    RewriteRule ^ index.html [L]
</IfModule>
